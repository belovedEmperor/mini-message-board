<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title><%= title %> | mini-message-board</title>
    </head>
    <body>
        <h1><%= title %></h1>
        <a href="/new"><button>New Message</button></a>
        <ul>
            <% for (const message of messages) { %>
                <%- include("messages/message", {message: message}) %>
            <% } %>
        </ul>
    </body>
</html>
