<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title><%= message.username %>'s Message | mini-message-board</title>
    </head>
    <body>
        <h1><%= message.username %></h1>
        <p><%= message.text %></p>
        <p>ID: <%= message.id %></p>
        <p>Posted on: <%= message.added %></p>
        <a href="/"><button>Back</button></a>
    </body>
</html>
